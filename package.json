{
  "name": "@youtyan/code-viewer",
  "version": "0.11.1",
  "description": "Local browser-based code and git diff viewer",
  "type": "module",
  "bin": {
    "code-viewer": "dist/code-viewer.js",
    "git-diff-preview": "dist/code-viewer.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youtyan/code-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/youtyan/code-viewer/issues"
  },
  "homepage": "https://github.com/youtyan/code-viewer#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "node scripts/build-web.mjs && node scripts/generate-third-party-notices.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:format": "biome format .",
    "dev": "tsx web-src/server/dev.ts",
    "preview": "tsx web-src/server/dev.ts",
    "preview:raw": "tsx web-src/server/preview.ts",
    "test:docker:up": "pnpm run test:redis:up && pnpm run test:redis:seed && pnpm run test:elasticsearch:up && pnpm run test:elasticsearch:seed && pnpm run test:postgres:up",
    "test:docker:down": "sh -c 'status=0; pnpm run test:redis:down || status=$?; pnpm run test:elasticsearch:down || status=$?; pnpm run test:postgres:down || status=$?; exit $status'",
    "test:redis:up": "docker compose -f data/test/redis/docker-compose.yml up -d --wait",
    "test:redis:seed": "cd data/test/redis && ./seed.sh",
    "test:redis:down": "docker compose -f data/test/redis/docker-compose.yml down -v",
    "test:elasticsearch:up": "docker compose -f data/test/elasticsearch/docker-compose.yml up -d --wait",
    "test:elasticsearch:seed": "cd data/test/elasticsearch && ./seed.sh",
    "test:elasticsearch:down": "docker compose -f data/test/elasticsearch/docker-compose.yml down -v",
    "test:postgres:up": "docker compose -f data/test/postgresql/docker-compose.yml up -d --wait",
    "test:postgres:down": "docker compose -f data/test/postgresql/docker-compose.yml down -v",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint web-src package.json biome.jsonc",
    "verify": "pnpm run check && pnpm run lint && pnpm run check:format && pnpm run build && pnpm run check:bundle && pnpm run test && node --check web/app.js && node --check web/mermaid.js && node --check web/shiki.js && node --check web/yaml.js && node --check web/xterm.js && node --check web/vendor/highlight.js/highlight.min.js && node --check dist/code-viewer.js && node dist/code-viewer.js --help && node scripts/node-smoke.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "keywords": [
    "git",
    "diff",
    "viewer",
    "npx",
    "npm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-dsv": "3.0.7",
    "@types/markdown-it": "14.1.2",
    "@types/pg": "8.20.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-dsv": "3.0.1",
    "esbuild": "^0.28.1",
    "highlight.js": "11.9.0",
    "markdown-it": "14.1.1",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "11.14.0",
    "shiki": "4.0.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "better-sqlite3": "12.9.0"
  },
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@redis/client": "6.1.0",
    "mysql2": "3.22.6",
    "pg": "8.22.0"
  }
}
